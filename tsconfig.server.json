{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-server",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "lib": ["ES2022"],
    "jsx": "preserve"
  },
  "include": ["src/server", "src/shared"],
  "exclude": ["node_modules", "dist", "dist-server", "src/worker", "src/frontend"]
}
