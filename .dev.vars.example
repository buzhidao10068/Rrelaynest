# 本地开发用的密钥示例。复制为 .dev.vars（勿提交），供 wrangler dev / Node server 读取。
# 生产环境：Workers 用 `wrangler secret put`，Docker 用容器环境变量。

# 登录密码
ADMIN_PASSWORD=change-me

# 会话 cookie 签名密钥（任意长随机串）
SESSION_SECRET=change-me-to-a-long-random-string

# 站点 access token 的 AES-GCM 加密密钥：base64 编码的 32 字节
# 生成：openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
