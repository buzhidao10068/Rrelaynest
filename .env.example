# Rrelaynest 环境变量 —— 复制为 .env 后填入真实值（.env 已被 .gitignore 排除）
#
#   cp .env.example .env
#
# 三个密钥均为必需，缺任一则容器启动即报错退出。

# 首个 admin 的初始登录密码（用户名固定为 admin）。
# 仅在「首次启动、库为空」时用于 seed；之后在设置页改密，此变量即不再影响登录。
# 请使用强口令。
ADMIN_PASSWORD=change-me-please

# 会话 cookie 的 HMAC 签名密钥。用于签名/校验登录态、MFA 短票、Passkey 挑战票。
# 生成：openssl rand -hex 32
SESSION_SECRET=

# 上游 API Key 等敏感字段的 AES-GCM 加密密钥。
# 生成：openssl rand -hex 32
ENCRYPTION_KEY=

# —— 可选 ——
# 监听端口（默认 3100）
# PORT=3100
# sqlite 文件路径（默认 data/rrelaynest.sqlite，容器内即挂载卷）
# DB_PATH=data/rrelaynest.sqlite
