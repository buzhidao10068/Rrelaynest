{
  "name": "rrelaynest",
  "version": "0.1.0",
  "description": "集中管理 LLM API 中转站（new-api）的自部署面板，可部署到 Cloudflare Workers 或 Docker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 7738",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "start:node": "node --enable-source-maps dist-server/index.js",
    "build:server": "tsc -p tsconfig.server.json",
    "db:init": "wrangler d1 execute rrelaynest-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute rrelaynest-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "hono": "^4.6.14",
    "node-cron": "^4.6.0",
    "socks": "^2.8.9",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "postcss": "^8.5.23",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "wrangler": "^4.114.0"
  }
}
