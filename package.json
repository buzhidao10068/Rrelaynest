{
  "name": "rrelaynest",
  "version": "0.2.0",
  "description": "集中管理 LLM API 中转站（new-api）的自部署面板，可部署到 Cloudflare Workers 或 Docker",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 7738",
    "i18n:tw": "node scripts/gen-zh-tw.mjs",
    "build": "npm run i18n:tw && vite build",
    "deploy": "npm run build && wrangler deploy",
    "start:node": "node --enable-source-maps dist-server/server/index.js",
    "build:server": "tsc -p tsconfig.server.json",
    "db:init": "wrangler d1 execute rrelaynest-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute rrelaynest-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "hono": "^4.6.14",
    "node-cron": "^4.6.0",
    "qrcode": "^1.5.4",
    "socks": "^2.8.9",
    "undici": "^8.9.0",
    "vue-i18n": "^11.4.8"
  },
  "overrides": {
    "brace-expansion": "^2.1.3",
    "ip-address": "^10.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "opencc-js": "^1.4.1",
    "postcss": "^8.5.23",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.12",
    "wrangler": "^4.114.0"
  }
}
